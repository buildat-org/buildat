<!-- The sky dome; see SkyDome.glsl beside this file.
     postopaque and no depth write is what keeps it behind the world; the box
     is seen from the inside, so nothing is culled. -->
<technique vs="shaders/res/SkyDome" ps="shaders/res/SkyDome">
    <pass name="postopaque" depthwrite="false" cull="none" />
</technique>
