<!-- [KIT_LIGHTING] KitVoxelAlpha.xml under physical lighting: its albedo decoded
     to linear (KITLINEAR), the frame being HDR; KITWATER
     ([KIT_PHYS_WATER_LOOK]) its reflection of the sky and the sun. -->
<technique vs="kit/KitVoxel" ps="kit/KitVoxel" vsdefines="KITLINEAR KITTINT" psdefines="KITLINEAR KITSPOTS KITNORMALS KITWATER DIFFMAP KITTINT">
    <pass name="alpha" depthwrite="false" blend="alpha" />
    <pass name="litalpha" depthwrite="false" blend="addalpha" />
    <pass name="shadow" vs="Shadow" ps="Shadow" />
</technique>
