[
 ["nav", "${URL}"],
 ["waitlog", "hello: Starport IDs taken", 90],
 ["waitlog", "accounts: the login page shown", 30],
 ["eval", "'isolated ' + crossOriginIsolated"],
 ["wait", 500],
 ["click", 600, 273],
 ["window", 1],
 ["until", "location.pathname == '/authorize' && document.readyState == 'complete' && !document.getElementById('login').classList.contains('hide')"],
 ["eval", "document.getElementById('name').value = 'webcb', document.getElementById('password').value = 'secret1', document.getElementById('login').requestSubmit(), 1"],
 ["until", "!document.getElementById('allow').classList.contains('hide')"],
 ["shot", "${OUT}/01_allow.png"],
 ["window", 0],
 ["eval", "window.__state = Module.buildatAuthState, new BroadcastChannel('buildat_starport').postMessage({buildat_starport_signin: 1, state: 'A'.repeat(32), code: '0'.repeat(32)}), 1"],
 ["waitlog", "a sign-in answer not of this attempt, ignored", 10],
 ["window", 1],
 ["eval", "document.getElementById('allow').requestSubmit(), 1"],
 ["window", 0],
 ["waitlog", "Joined as cbname", 30],
 ["windows", 1],
 ["shot", "${OUT}/02_joined.png"],
 ["eval", "new BroadcastChannel('buildat_starport').postMessage({buildat_starport_signin: 1, state: window.__state, code: '0'.repeat(32)}), 1"],
 ["waitlog", "a sign-in answer not of this attempt, ignored", 10]
]
